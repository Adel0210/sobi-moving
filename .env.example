# Copy to .env.local and fill in. Never commit .env.local.
#
# Lead notification degrades quietly: with RESEND_API_KEY or LEAD_NOTIFY_TO
# unset, forms still save to Supabase and the route logs a warning instead of
# sending. Set both to turn the email on.

# Supabase project URL. Public by design, safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key. Public by design, RLS is what guards the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Resend API key that sends the new lead email. Create one at resend.com/api-keys.
RESEND_API_KEY=re_your_api_key

# Inbox that receives new lead notifications. Comma separate for more than one.
LEAD_NOTIFY_TO=owner@example.com

# Optional sender for those notifications. Must be on a domain verified in Resend.
# Defaults to "Sobi Moving Website <leads@sobimoving.com>".
LEAD_NOTIFY_FROM=Sobi Moving Website <leads@sobimoving.com>
